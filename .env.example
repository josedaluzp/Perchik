# CCH Axcess OIP — OAuth 2.0 (authorization_code + refresh). Ver
# .claude/skills/cch-axcess-client/references/oauth-auth.md
# NUNCA poner valores reales aquí ni en el repo. Valores reales solo en .env (gitignored).

# Credenciales de la app registrada (Dashboard > Developer Tools > Add Application)
CCH_OIP_CLIENT_ID=
CCH_OIP_CLIENT_SECRET=

# Redirect URL https registrada (localhost NO permitido)
CCH_OIP_REDIRECT_URI=

# Account number del firm (6 dígitos), usado en acr_values
CCH_OIP_ACCOUNT_NUMBER=

# Refresh token obtenido tras el consentimiento inicial (paso 1-2). Se renueva solo.
CCH_OIP_REFRESH_TOKEN=

# Endpoints (fijos, override solo si cambian)
CCH_OIP_AUTH_BASE=https://login.cchaxcess.com/ps/auth/v1.0/core/connect
CCH_OIP_API_BASE=https://api.cchaxcess.com

# Scopes (separados por espacio)
CCH_OIP_SCOPES=CCHAxcess_data_writeaccess offline_access openid IDInfo

# Subscription key del producto "Tax APIs" en developers.cchaxcess.com > Profile
# (NO la de "All APIs - Limited Use" — esa está limitada a 10 calls/min)
CCH_OIP_SUBSCRIPTION_KEY=

# Header IntegratorKey que pide el "Try it" del portal — origen todavía sin
# resolver (no salió en Profile ni en el registro de la app OAuth). Dejar
# vacío hasta confirmarlo con WK; el cliente lo omite si no está seteado.
CCH_OIP_INTEGRATOR_KEY=
